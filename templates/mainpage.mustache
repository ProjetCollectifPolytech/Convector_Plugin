{{!
    @template local_offlinequizaddons/mainpage

    Main page template for OfflineQuiz Addons plugin.

    Context variables required for this template:
    * title - The page title
    * helloworld - The hello world string
    * welcome - The welcome message
    * cmid - The course module ID
    * offlinequizname - The name of the offlinequiz (optional)

    Example context (json):
    {
        "title": "OfflineQuiz Addons",
        "helloworld": "Hello World",
        "welcome": "Welcome to OfflineQuiz Addons",
        "cmid": 123,
        "offlinequizname": "My Quiz"
    }
}}

<div class="local-offlinequizaddons-mainpage">
    <div class="text-center p-5">
        <h1 class="display-4 mb-4">{{helloworld}}</h1>
        <p class="lead">{{welcome}}</p>
        {{#offlinequizname}}
        <div class="mt-4">
            <p class="text-muted">{{#str}}pluginname, local_offlinequizaddons{{/str}} for: <strong>{{offlinequizname}}</strong></p>
        </div>
        {{/offlinequizname}}
    </div>
    
    <div class="alert alert-info mt-4">
        <h4>{{#str}}pluginname, local_offlinequizaddons{{/str}}</h4>
        <p>This plugin extends OfflineQuiz without modifying its core code.</p>
        <p>Available features:</p>
        <ul>
            <li><strong>{{#str}}temporal_convector, local_offlinequizaddons{{/str}}</strong> - Normalize page counts across all exam copies</li>
            <li>Custom reports and analytics (coming soon)</li>
            <li>Additional quiz management tools (coming soon)</li>
            <li>Enhanced export/import features (coming soon)</li>
        </ul>
    </div>

    <div class="row mt-4">
        <div class="col-md-6 mb-3">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">
                        <i class="icon fa fa-file-pdf"></i> {{#str}}temporal_convector, local_offlinequizaddons{{/str}}
                    </h5>
                    <p class="card-text">{{#str}}temporal_description, local_offlinequizaddons{{/str}}</p>
                    <a href="temporal.php?id={{cmid}}" class="btn btn-primary">
                        {{#str}}temporal_convector, local_offlinequizaddons{{/str}}
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

