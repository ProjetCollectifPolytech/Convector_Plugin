{{!
    @template local_offlinequizaddons/mainpage

    Main page template for OfflineQuiz Addons plugin.

    Context variables required for this template:
    * title - The page title
    * helloworld - The hello world string
    * welcome - The welcome message
    * cmid - The course module ID
    * offlinequizname - The name of the offlinequiz (optional)

    Example context (json):
    {
        "title": "OfflineQuiz Addons",
        "helloworld": "Hello World",
        "welcome": "Welcome to OfflineQuiz Addons",
        "cmid": 123,
        "offlinequizname": "My Quiz"
    }
}}

<div class="local-offlinequizaddons-mainpage">
    <div class="text-center p-5">
        <h1 class="display-4 mb-4">{{helloworld}}</h1>
        <p class="lead">{{welcome}}</p>
        {{#offlinequizname}}
        <div class="mt-4">
            <p class="text-muted">{{#str}}pluginname, local_offlinequizaddons{{/str}} for: <strong>{{offlinequizname}}</strong></p>
        </div>
        {{/offlinequizname}}
    </div>
    
    <div class="alert alert-info mt-4">
        <h4>{{#str}}pluginname, local_offlinequizaddons{{/str}}</h4>
        <p>This is a demonstration page. This plugin extends OfflineQuiz without modifying its core code.</p>
        <p>Future functionality can be added here such as:</p>
        <ul>
            <li>Custom reports and analytics</li>
            <li>Additional quiz management tools</li>
            <li>Enhanced export/import features</li>
            <li>Custom settings and configurations</li>
        </ul>
    </div>
</div>
